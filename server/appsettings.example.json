{
  "App": {
    "Port": 5000,
    "NodeEnv": "development",
    "BrandName": "TürkiyeAI",
    "TechBrand": "OrkinosAI",
    "Domain": "turkiyeai.travel"
  },
  "AzureOpenAI": {
    "Endpoint": "https://your-resource.openai.azure.com/",
    "ApiKey": "your-openai-api-key",
    "DeploymentName": "gpt-4",
    "ApiVersion": "2024-02-15-preview",
    "MaxTokens": 800,
    "Temperature": 0.7,
    "TopP": 0.95,
    "FrequencyPenalty": 0,
    "PresencePenalty": 0
  },
  "AzureSearch": {
    "Endpoint": "https://your-search-service.search.windows.net",
    "ApiKey": "your-search-api-key",
    "IndexName": "turkeyai-travel-index"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-db.postgres.database.azure.com;Port=5432;Database=turkeyai;Username=your-db-user;Password=your-db-password;SSL Mode=Require"
  },
  "Database": {
    "Host": "your-db.postgres.database.azure.com",
    "Port": 5432,
    "Name": "turkeyai",
    "User": "your-db-user",
    "Password": "your-db-password",
    "SSL": true
  },
  "Settings": {
    "UseWebsiteSettings": true,
    "SettingsSourceUrl": ""
  }
}
