{
  "name": "turkeyai-server",
  "version": "1.0.0",
  "description": "TürkiyeAI Backend - Azure AI-Powered Travel Agent API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/appSettings.test.js && node tests/settingsProvider.test.js && node tests/models.test.js && node tests/routes.test.js && node tests/agentConfig.test.js",
    "search:create-index": "node config/createSearchIndex.js create",
    "search:index-info": "node config/createSearchIndex.js info",
    "search:populate": "node config/populateSearchIndex.js populate",
    "search:clear": "node config/populateSearchIndex.js clear"
  },
  "keywords": [
    "express",
    "azure",
    "ai",
    "travel",
    "api"
  ],
  "author": "OrkinosAI Ltd",
  "license": "ISC",
  "dependencies": {
    "@azure/openai": "^1.0.0-beta.11",
    "@azure/search-documents": "^12.0.0",
    "axios": "^1.6.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
