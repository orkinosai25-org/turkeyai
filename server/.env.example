# Server Configuration
PORT=5000
NODE_ENV=development

# Azure OpenAI Configuration (local fallback)
# These settings are used if website settings are unavailable
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Optional: Override default chat parameters
# AZURE_OPENAI_MAX_TOKENS=800
# AZURE_OPENAI_TEMPERATURE=0.7
# AZURE_OPENAI_TOP_P=0.95
# AZURE_OPENAI_FREQUENCY_PENALTY=0
# AZURE_OPENAI_PRESENCE_PENALTY=0

# Settings Provider Configuration
# Set to 'false' to disable fetching settings from website and use only local env vars
USE_WEBSITE_SETTINGS=true
# Optional: Override the default settings source URL
# SETTINGS_SOURCE_URL=https://raw.githubusercontent.com/orkinosai25-org/orkinosai-website/main/src/orkinosaiCMS.Server/appsettings.json

# Azure AI Search Configuration
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your-search-api-key-here
AZURE_SEARCH_INDEX_NAME=turkeyai-travel-index

# Azure PostgreSQL Configuration
DB_HOST=your-postgres-server.postgres.database.azure.com
DB_PORT=5432
DB_NAME=turkeyai
DB_USER=your-admin-user
DB_PASSWORD=your-password
DB_SSL=true

# Application Settings
BRAND_NAME=TürkiyeAI
TECH_BRAND=OrkinosAI
DOMAIN=turkiyeai.travel
