# Server Configuration
PORT=5000
NODE_ENV=development

# Azure OpenAI Configuration (local fallback)
# These settings are used if website settings are unavailable
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Optional: Override default chat parameters
# AZURE_OPENAI_MAX_TOKENS=800
# AZURE_OPENAI_TEMPERATURE=0.7
# AZURE_OPENAI_TOP_P=0.95
# AZURE_OPENAI_FREQUENCY_PENALTY=0
# AZURE_OPENAI_PRESENCE_PENALTY=0

# Settings Provider Configuration
# Set to 'false' to disable fetching settings from website and use only local env vars
USE_WEBSITE_SETTINGS=true
# Optional: Override the default settings source URL.
# Can be a plain HTTP(S) URL returning JSON with an AzureOpenAI section, or a
# raw.githubusercontent.com URL (automatically upgraded to GitHub Contents API
# when SETTINGS_API_TOKEN is also set).
# SETTINGS_SOURCE_URL=https://raw.githubusercontent.com/orkinosai25-org/orkinosai-website/main/src/orkinosaiCMS.Server/appsettings.json

# Optional: GitHub Personal Access Token (PAT) for accessing private repository
# settings files. Required when SETTINGS_SOURCE_URL points to a private GitHub
# raw content URL. The token needs at least repo:read (or contents:read) scope.
# SETTINGS_API_TOKEN=ghp_your_personal_access_token_here

# Azure AI Search Configuration
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your-search-api-key-here
AZURE_SEARCH_INDEX_NAME=turkeyai-travel-index
# Knowledge base search index (created via: npm run knowledge:create-index)
AZURE_KNOWLEDGE_INDEX_NAME=turkeyai-knowledge-index

# Azure PostgreSQL Configuration (Azure AD / Entra ID passwordless auth)
# Host, port, database, and AAD user — password is fetched automatically via DefaultAzureCredential
DB_HOST=turkeyai-server.postgres.database.azure.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=Ismail@orkinosai.com
DB_PASSWORD=
DB_SSL=true
# Set DB_USE_AAD_AUTH=true to fetch a fresh Azure AD access token as the password at connect-time.
# Required when connecting with an Azure AD / Entra ID user (e.g. on Azure App Service with Managed Identity).
# When false (default), DB_PASSWORD is used as a static password.
DB_USE_AAD_AUTH=true

# Application Settings
BRAND_NAME=TürkiyeAI
TECH_BRAND=OrkinosAI
DOMAIN=turkiyeai.travel
