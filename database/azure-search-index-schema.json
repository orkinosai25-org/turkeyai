  "suggesters": [
    {
      "name": "sg-resorts",
      "searchMode": "analyzingInfixMatching",
      "sourceFields": [
        "resort_name",
        "region",
        "amenities"
      ]
    }
  ],
  "scoringProfiles": [
    {
      "name": "boostByRating",
      "text": {
        "weights": {
          "resort_name": 2.0,
          "description": 1.5,
          "amenities": 1.0
        }
      },
      "functions": [
        {
          "type": "magnitude",
          "fieldName": "star_rating",
          "boost": 2.0,
          "interpolation": "linear",
          "magnitude": {
            "boostingRangeStart": 1,
            "boostingRangeEnd": 5,
            "constantBoostBeyondRange": false
          }
        }
      ]
    }
  ],
  "corsOptions": {
    "allowedOrigins": ["*"],
    "maxAgeInSeconds": 300
  },
  "semanticSearch": {
    "configurations": [
      {
        "name": "resort-semantic-config",
        "prioritizedFields": {
          "titleField": {
            "fieldName": "resort_name"
          },
          "prioritizedContentFields": [
            {
              "fieldName": "description"
            },
            {
              "fieldName": "season_notes"
            }
          ],
          "prioritizedKeywordsFields": [
            {
              "fieldName": "amenities"
            },
            {
              "fieldName": "vibe_tags"
            }
          ]
        }
      }
    ]
  }
}
